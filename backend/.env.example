# Local-safe defaults for this project.
# Keep real API keys blank unless you explicitly want to use live providers.
# For offline/local development, leave AI_PROVIDER_MODE=mock.

PROJECT_NAME=AIC 2026 Backend Engine
STATIC_DIR=static
DATA_DIR=data
FEATURE_ROOT=data/features
MAP_ROOT=data/map_keyframes
KEYFRAMES_DIR=static/keyframes
VIDEOS_DIR=static/videos
ZIP_INBOX_DIR=data/inbox
ZIP_INGEST_ENABLED=false
FAISS_INDEX_PATH=data/faiss_index.bin
METADATA_PATH=data/metadata.json
VECTOR_BACKEND=faiss
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=aic_keyframes
MILVUS_TIMEOUT_SECONDS=5
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aic_keyframes
QDRANT_TIMEOUT_SECONDS=5
HYBRID_RRF_K=60
HYBRID_METADATA_RERANK_ENABLED=true
HYBRID_METADATA_RERANK_WEIGHT=0.12
# Enable hybrid retrieval by setting VECTOR_BACKEND=faiss when Milvus is running.
# AI_PROVIDER_MODE defaults to 'mock' for portability (no API keys required)
# Set to 'real' or 'production' to use actual AI APIs
AI_PROVIDER_MODE=mock
# TEXT_ENCODER_PROVIDER defaults to 'mock' for portability (no model download required)
# Set to 'sentence_transformers' to use actual CLIP model
TEXT_ENCODER_PROVIDER=sentence_transformers
# Cross-encoder rescoring (opt-in) - disable for portability
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_TOP_K=20
CROSS_ENCODER_WEIGHT=0.7
TEXT_ENCODER_FALLBACK_TO_MOCK=true
CLIP_MODEL_NAME=sentence-transformers/clip-ViT-B-32
MOCK_EMBEDDING_DIM=512
TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=google_gtx
TRANSLATION_SOURCE_LANGUAGE=vi
TRANSLATION_TARGET_LANGUAGE=en
GOOGLE_TRANSLATION_API_BASE=https://translate.googleapis.com
GEMINI_TRANSLATION_API_BASE=https://generativelanguage.googleapis.com
OPENAI_TRANSLATION_API_BASE=https://api.openai.com
BACKEND_HOST=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEARCH_API_ENDPOINT=/api/v1/search
STATIC_PATH=/static/keyframes
TOP_K_DEFAULT=20
MAX_QUERY_LENGTH=1000
MAX_TOP_K=100
TRANSLATION_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Cache (default: in-memory LRU; switch to redis for shared deployments)
CACHE_BACKEND=memory
REDIS_URL=
CACHE_MAX_ENTRIES=2048
EMBEDDING_CACHE_TTL_SECONDS=0
TRANSLATION_CACHE_TTL_SECONDS=0
VLM_CACHE_TTL_SECONDS=0

# Latency target and benchmark defaults (KIS retrieval path)
LATENCY_SLA_MS=1000
CLIP_WARMUP_ENABLED=true
CLIP_WARMUP_QUERY=a person walking in a room
LATENCY_BENCHMARK_WARMUP=2
LATENCY_BENCHMARK_REPEATS=10

# Mock competition drill (3h budget, 50% sample default)
MOCK_COMPETITION_BUDGET_HOURS=3
MOCK_COMPETITION_SAMPLE_FRACTION=0.5

# VQA configuration
VQA_PROVIDER=gemini
VQA_TIMEOUT_SECONDS=60
VQA_MAX_CONCURRENCY=8
VQA_COUNTING_STRATEGY=scale_aware
SPATIAL_VQA_ATTENTION_ENABLED=true
TEMPORAL_VQA_CONTEXT_ENABLED=true
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_VQA_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
CLAUDE_VQA_MODEL=claude-3-5-haiku-latest
QWEN_API_KEY=
QWEN_VQA_MODEL=qwen-vl-max
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Object Detection & Media Info Reranking (P2)
OBJECT_ROOT=data/objects
MEDIA_INFO_ROOT=data/media_info
KIS_OBJECT_RERANK_ENABLED=true
KIS_OBJECT_RERANK_WEIGHT=0.10
KIS_MEDIA_INFO_ENRICH_ENABLED=true
KIS_MEDIA_INFO_RERANK_ENABLED=true
KIS_MEDIA_INFO_RERANK_WEIGHT=0.10

# Query Expansion & Visual Paraphrasing (P1)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MODE=template
QUERY_EXPANSION_NUM_VARIATIONS=3
QUERY_EXPANSION_ORIGINAL_WEIGHT=0.6
QUERY_EXPANSION_EXPANDED_WEIGHT=0.4
QUERY_EXPANSION_CACHE_TTL_SECONDS=86400

# Temporal Context Smoothing (P1)
TEMPORAL_SMOOTHING_ENABLED=true
TEMPORAL_SMOOTHING_WINDOW_SECONDS=6.0
TEMPORAL_SMOOTHING_SIGMA=3.0
TEMPORAL_SMOOTHING_WEIGHT=0.15

# Intra-Video Diversification & Deduplication (P1)
DIVERSIFICATION_ENABLED=true
DIVERSIFICATION_MIN_GAP_SECONDS=3.5
DIVERSIFICATION_MAX_PER_VIDEO=3
DIVERSIFICATION_MODE=soft_penalty
DIVERSIFICATION_PENALTY_WEIGHT=0.08

# Ensemble Text Encoder (opt-in)
TEXT_ENCODER_ENSEMBLE_ENABLED=false
ENSEMBLE_MODEL_NAME=sentence-transformers/clip-ViT-B-32-multilingual-v1
# KIS Candidate Pool Depth
KIS_CANDIDATE_POOL_SIZE=1000

# Regional Crop-Level CLIP Alignment (P1)
KIS_CROP_ALIGNMENT_ENABLED=true
KIS_CROP_ALIGNMENT_TOPK=15
KIS_CROP_ALIGNMENT_WEIGHT=0.12

# Multi-Concept Semantic Decomposition & Orthogonal Fusion (P1)
MULTI_CONCEPT_DECOMPOSITION_ENABLED=true
MULTI_CONCEPT_WEIGHT_GLOBAL=0.45
MULTI_CONCEPT_WEIGHT_ENTITY=0.20
MULTI_CONCEPT_WEIGHT_ATTRIBUTE=0.15
MULTI_CONCEPT_WEIGHT_ACTION=0.10
MULTI_CONCEPT_WEIGHT_SCENE=0.10

# Visual Pseudo-Relevance Feedback (Visual PRF / Rocchio)
VISUAL_PRF_ENABLED=true
VISUAL_PRF_TOPK=3
VISUAL_PRF_WEIGHT=0.20
VISUAL_PRF_BLEND_ALPHA=0.30

# Temporal Shot Consensus Graph Filtering
TEMPORAL_CONSENSUS_ENABLED=true
TEMPORAL_CONSENSUS_WINDOW_SECONDS=15.0
TEMPORAL_CONSENSUS_BOOST_WEIGHT=0.15
TEMPORAL_CONSENSUS_ISOLATED_PENALTY=0.04



